# ops-support's own .env: copy to .env (or `make env`) and fill in. It's git-ignored; never commit it.
# docker compose passes this WHOLE file into the Memgraph container (env_file), where
# `docker inspect memgraph-mage` shows it. Keep only Memgraph settings and embedding-provider
# keys here. Which model is used is set in each workspace's ops.yaml (semantic.embeddings.model).

# Memgraph (docker-compose.yml creates this user on first start)
MEMGRAPH_USER=ops
MEMGRAPH_PASSWORD=change-me

# --- Embeddings (read by the Memgraph container at `docker compose up`; layer design §4.5(a)) ---
# The whole .env is passed to Memgraph, so LiteLLM inside it reads provider keys from here.
# Keys never go in ops.yaml. Set only what your model needs.
# HF_HOME is set in docker-compose.yml to /var/lib/memgraph/hf-cache (on the bind mount)
# HF_TOKEN=                              # gated or private Hugging Face models
# HF_HUB_OFFLINE=0                       # 1 = never download; the model must already be cached
# OPENAI_API_KEY=                        # openai/... models
# AZURE_API_KEY=                         # azure/<deployment> models
# AZURE_API_BASE=
# AZURE_API_VERSION=
# COHERE_API_KEY=                        # cohere/... models
# VOYAGE_API_KEY=                        # voyage/... models
# MISTRAL_API_KEY=                       # mistral/... models
# GEMINI_API_KEY=                        # gemini/... models
# AWS_ACCESS_KEY_ID=                     # bedrock/... models
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION_NAME=
# ollama/... models need no key: set semantic.embeddings.api_base in ops.yaml instead

# Workspace secrets (database URLs, Redis passwords, ...) do NOT belong here. `ops init` writes
# them to the workspace's own .env.example; put their values in the workspace's .env, which
# `ops` / `ops-mcp` read (the process env wins over it).
