# Copy to .env and fill in. .env is git-ignored; never commit real credentials.
# Read by docker compose (Memgraph container) and by `ops` / `ops-mcp` (process env wins over .env).

# Memgraph (docker-compose.yml creates this user on first start)
MEMGRAPH_USER=ops
MEMGRAPH_PASSWORD=change-me

# `ops init` appends the env vars your workspace's ops.yaml references below, e.g.
# ORDERS_DB_URL=postgres://app:secret@localhost:5432/orders
# REDIS_PASSWORD=
